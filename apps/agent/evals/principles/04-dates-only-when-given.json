{
  "statement": "A date is set only when the dump gives one. Relative words are read against today, a month with no year means the next time that month comes, and soon is not a date.",
  "why": "An invented date puts a wrong row on somebody's calendar, and that is worse than a row with no date, which is honest and easy to fix. Late December is where this goes wrong silently: the 3rd is January.",
  "sources": [
    "006 AC-3, AC-4",
    "014 AC-18",
    "plan_v2.md: Dates",
    "quick_add.md: Dates"
  ],
  "cases": [
    {
      "id": "soon-is-not-a-date",
      "why": "soon gets nothing",
      "surface": "file",
      "input": "fix the leaking tap soon",
      "context": "behrooz",
      "expect": {
        "filed": [
          {
            "type": "task",
            "no_date": true
          }
        ],
        "say": null
      }
    },
    {
