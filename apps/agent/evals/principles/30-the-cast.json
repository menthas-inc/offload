    {
      "id": "behrooz-home-keeps-his-words",
      "why": "Home is shared with Meera: his memory decides nothing about the words",
      "surface": "cast-file",
      "input": {
        "character": "behrooz",
        "looking_at": "home",
        "dump": "dinner with my wife friday 7pm"
      },
      "expect": {
        "written_lacks": [
          "Meera"
        ],
        "not_called": [
          "memory"
        ]
      }
    },
    {
      "id": "behrooz-studio-remembers",
      "why": "an explicit ask in his own thread is remembered and named",
      "surface": "cast-file",
      "input": {
        "character": "behrooz",
        "looking_at": "behrooz.studio",
        "dump": "remember that when I say standup I mean the 9:30 offload sync"
