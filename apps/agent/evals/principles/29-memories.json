    {
      "id": "what-do-you-remember",
      "why": "until the tab exists, asking is how a person sees their memories",
      "surface": "answer",
      "context": "behrooz",
      "memories": [
        {
          "kind": "people",
          "text": "Their wife is Meera."
        },
        {
          "kind": "about",
          "text": "They work at Shopify as a designer."
        }
      ],
      "input": "what do you remember about me?",
      "expect": {
        "contains": [
          "Meera",
          "Shopify"
        ],
        "must_not_contain": [
          "Their wife",
          "Portugal"
        ]
      }
    },
    {
      "id": "first-person-is-theirs",
      "why": "040: a memory typed in the tab is kept as typed, so 'my' in it is the person, not offload",
      "surface": "answer",
      "context": "behrooz",
      "memories": [
        {
          "kind": "people",
          "text": "My sister is Rina."
        }
      ],
      "input": "what's my sister's name?",
      "expect": {
        "contains": [
          "Rina"
        ],
