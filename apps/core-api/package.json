{
  "name": "@offload/core-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --import ./src/preload-env.ts --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "migrate": "node --import tsx --import ./src/preload-env.ts src/migrate.ts",
    "seed": "node --import tsx --import ./src/preload-env.ts src/seed.ts",
    "seed:admins": "node --import tsx --import ./src/preload-env.ts src/seed-admins.ts",
    "agent:role": "node --import tsx --import ./src/preload-env.ts src/agent-role.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@better-auth/expo": "^1.7.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.1.1",
    "@offload/tokens": "workspace:^",
    "@offload/widgets": "workspace:^",
    "better-auth": "^1.7.5",
    "expo-server-sdk": "^7.2.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^6.1.0",
    "html-to-text": "^10.0.1",
    "image-size": "^2.0.4",
    "kysely": "^0.29.5",
    "libmime": "^5.4.6",
    "mailauth": "^7.1.0",
    "mailparser": "^3.9.32",
    "nodemailer": "^10.0.13",
    "pg": "^8.13.1",
    "pngjs": "7.0.0",
    "svix": "^2.6.1",
    "yazl": "^3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "yauzl": "^3"
  }
}
