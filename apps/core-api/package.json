{
  "name": "@offload/core-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node --import tsx src/migrate.ts",
    "seed": "node --import tsx src/seed.ts",
    "seed:admins": "node --import tsx src/seed-admins.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@offload/tokens": "workspace:^",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
