    "android": {
      "package": "club.offload.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "./plugins/with-share-relaunch.js",
      "expo-secure-store",
      [
        "expo-share-intent",
        {
          "iosActivationRules": "SUBQUERY (extensionItems, $e, SUBQUERY ($e.attachments, $a, (ANY $a.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.image\" OR ANY $a.registeredTypeIdentifiers UTI-CONFORMS-TO \"com.adobe.pdf\")).@count >= 1 AND SUBQUERY ($e.attachments, $a, (ANY $a.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.image\" OR ANY $a.registeredTypeIdentifiers UTI-CONFORMS-TO \"com.adobe.pdf\")).@count <= 10).@count >= 1",
          "androidIntentFilters": [
            "image/*",
            "application/pdf"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "application/pdf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "So a photo you pick can be dumped in.",
          "cameraPermission": "So a photo you take can be dumped in."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-system-ui",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Instrument Sans",
                "fontDefinitions": [
                  {
                    "path": "../../node_modules/@expo-google-fonts/instrument-sans/400Regular/InstrumentSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/instrument-sans/500Medium/InstrumentSans_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "../../node_modules/@expo-google-fonts/instrument-sans/600SemiBold/InstrumentSans_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Literata",
                "fontDefinitions": [
                  {
                    "path": "../../node_modules/@expo-google-fonts/literata/400Regular/Literata_400Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "../../node_modules/@expo-google-fonts/instrument-sans/400Regular/InstrumentSans_400Regular.ttf",
              "../../node_modules/@expo-google-fonts/instrument-sans/500Medium/InstrumentSans_500Medium.ttf",
              "../../node_modules/@expo-google-fonts/instrument-sans/600SemiBold/InstrumentSans_600SemiBold.ttf",
              "../../node_modules/@expo-google-fonts/literata/400Regular/Literata_400Regular.ttf"
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "For voice notes. Nothing is recorded until you tap the microphone."
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "record": {
              "foregroundImage": "./assets/quick-record.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          "iosIcons": {}
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F7",
          "dark": {
            "image": "./assets/splash-mark-dark.png",
            "backgroundColor": "#1C1B19"
          },
          "ios": {
            "imageWidth": 216
          },
          "android": {
            "imageWidth": 192
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#3F6B4F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "menthas_offload",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b52f487-7c53-4d9d-a389-889ccc79798d",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "club.offload.app.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.club.offload.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9b52f487-7c53-4d9d-a389-889ccc79798d",
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "platforms": [
      "ios",
      "android"
    ]
