{
  "expo": {
    "name": "offload",
    "slug": "offload",
    "scheme": "offload",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "club.offload.app",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "club.offload.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": { "typedRoutes": true }
  }
}
