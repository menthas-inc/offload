# Copy to .env and fill in. .env is gitignored and must never be committed.
# Railway holds the deployed values; this file is local development only.

# ---- Core ----
NODE_ENV=development
API_PORT=4701
WEB_PORT=4700

# ---- Database ----
# Local Postgres runs in Docker on 4710, because 5432 and 5433 are already taken.
DATABASE_URL=postgres://offload:offload@localhost:4710/offload

# ---- URLs ----
# These drive OAuth redirects, CORS and the cookie domain, so they must match
# exactly what is registered with each provider.
API_URL=http://localhost:4701
WEB_URL=http://localhost:4700
COOKIE_DOMAIN=localhost

# ---- Auth ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: the Services ID, not the App ID. Empty until the domain is verified,
# which needs a deploy, so Google-only works fine before then.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 contents. Keep the newlines, or wrap the whole thing in quotes.
APPLE_PRIVATE_KEY=

# ---- Email ----
RESEND_API_KEY=
EMAIL_FROM=offload@offload.club

# ---- DNS ----
# Cloudflare token scoped to Zone > DNS > Edit on offload.club only.
# Used to add the api, staging and api.staging records rather than doing it by
# hand three times. Nothing reads this at runtime; it is tooling only.
CLOUDFLARE_API_TOKEN=

# ---- Seeding ----
# Read once by `seed:admins`, then never again. Not read on any request path.
ADMIN_EMAILS=

# ---- Encryption ----
# The root of the key hierarchy: 32 bytes, base64. Every account key in the
# database is wrapped by it, and the rows that hold them are stamped `db:v1`
# so moving custody to a KMS later is a rewrap job rather than a migration.
#
#   openssl rand -base64 32
#
# Required in production and refused at boot without one. Left empty locally,
# where it is derived from BETTER_AUTH_SECRET so a test database needs no key
# provisioning. Never copy the production value into a local file.
DATA_ROOT_KEY=

# The agent plane, feature 003.
#
# ANTHROPIC_API_KEY is a service account key scoped to a workspace, not an
# organisation key, so spend and revocation are per workload. Workload Identity
# Federation would remove this secret entirely and needs an ambient OIDC
# identity, which Railway does not provide. See docs/tech/decisions.md.
ANTHROPIC_API_KEY=

# Shared by the Core API and the worker, private network only. Any long random
# string; it is compared in constant time. 32 characters minimum.
INTERNAL_SERVICE_TOKEN=

# The worker's own connection, as the offload_agent role, which holds select on
# six tables and update on jobs and nothing else. Do not set this by hand:
# `pnpm agent:role` mints the password, grants the role login, and writes this
# line. Run it again to rotate.
AGENT_DATABASE_URL=
