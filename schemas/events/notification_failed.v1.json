{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offload.club/schemas/events/notification_failed.v1.json",
  "title": "notification_failed",
  "description": "The push service refused a send. The kind, the status and the error code, and nothing from the body.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "status", "code"],
  "properties": {
    "kind": { "type": "string", "enum": ["digest", "reminder", "request", "share", "shared_activity"] },
    "status": { "type": "integer", "minimum": 0 },
    "code": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z_]+$" }
  }
}
