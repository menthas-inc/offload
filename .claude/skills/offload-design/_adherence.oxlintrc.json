{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/answering/**",
              "components/brand/**",
              "components/conversation/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/notifications/**",
              "explorations/**",
              "ui_kits/admin_web/**",
              "ui_kits/android_app/**",
              "ui_kits/mobile_app/**",
              "ui_kits/web_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Sans|Literata))/i]",
        "message": "Font not provided by the design system. Available: Instrument Sans, Literata."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|meta|type|done|key|ref|className|style|children)$/]",
        "message": "<AnswerRow> doesn't accept that prop. Declared props: id, title, meta, type, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerRow'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:task|event|location|link|image|file|voice|note)$/]",
        "message": "<AnswerRow> type must be one of 'task' | 'event' | 'location' | 'link' | 'image' | 'file' | 'voice' | 'note'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|left|right|border|align|style|key|ref|className|style|children)$/]",
        "message": "<AppBar> doesn't accept that prop. Declared props: title, subtitle, left, right, border, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<AppBar> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:uid|initials|name|size|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: uid, initials, name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|variant|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|attention|warning|danger)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'attention' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'solid'."
