{
  "name": "offload",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "lint": "eslint .",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "tokens": "pnpm --filter @offload/tokens build",
    "db:migrate": "pnpm --filter @offload/core-api migrate",
    "db:seed": "pnpm --filter @offload/core-api seed",
    "seed:admins": "pnpm --filter @offload/core-api seed:admins",
    "start": "node scripts/start.mjs",
    "agent:role": "pnpm --filter @offload/core-api agent:role"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4 <5.0.12": "^5.0.12",
      "compression@<1.8.2": "^1.8.2",
      "fast-uri@>=3 <3.1.8": "^3.1.8",
      "postcss@<8.5.23": "^8.5.29",
      "shell-quote@<1.11.0": "^1.11.0",
      "source-map-js@<1.2.2": "^1.2.2"
    },
    "patchedDependencies": {
      "expo-share-intent@8.0.1": "patches/expo-share-intent@8.0.1.patch"
    }
  }
}
