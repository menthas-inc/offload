{
  "name": "offload",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "lint": "eslint .",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "tokens": "pnpm --filter @offload/tokens build",
    "db:migrate": "pnpm --filter @offload/core-api migrate",
    "db:seed": "pnpm --filter @offload/core-api seed",
    "seed:admins": "pnpm --filter @offload/core-api seed:admins",
    "start": "node scripts/start.mjs",
    "agent:role": "pnpm --filter @offload/core-api agent:role"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4 <5.0.12": "^5.0.12",
      "compression@<1.8.2": "^1.8.2",
      "postcss@<8.5.23": "^8.5.29",
      "shell-quote@<1.11.0": "^1.11.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "fast-uri@>=3 <3.1.9": "^3.1.9",
      "fast-uri@>=4 <4.2.3": "^4.2.3",
      "decode-uri-component@<0.5.1": "^0.5.1",
      "node-forge@<1.4.3": "^1.4.3",
      "undici@>=7 <7.30.1": "^7.30.1",
      "undici@>=8 <8.12.2": "^8.12.2",
      "vite@>=8.3.0 <8.3.3": "^8.3.3",
      "@vitest/mocker@<4.1.12": "^4.1.12",
      "fast-xml-parser@<5.12.0": "^5.12.0",
      "glob@>=9 <14.0.2": "^14.0.2",
      "joi@>=18 <18.3.1": "^18.3.1",
      "minimatch@>=7 <11.0.1": "^11.0.1",
      "nodemailer@<10.1.4": "^10.1.4",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "zod@>=4 <4.6.6": "^4.6.6"
    },
    "patchedDependencies": {
      "expo-share-intent@8.0.1": "patches/expo-share-intent@8.0.1.patch"
    }
  }
}
