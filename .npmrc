# Expo requires a hoisted node_modules.
#
# pnpm's isolated layout is the reason to use pnpm, and it is the one thing
# Metro cannot resolve through. Concretely: nativewind's babel preset rewrites
# JSX to `react-native-css-interop/jsx-runtime`, whose subpath package.json has
# `main: "../dist/runtime/jsx-runtime"`. That path escapes the subdirectory,
# and resolving it through pnpm's symlinked package works in Node and fails in
# Metro, so every screen fails to bundle.
#
# This file said the opposite for a while. Hoisting was added to fix a Metro
# hang, did not fix it, and was reverted; the hang turned out to be a Node
# version mismatch. The revert was right about the hang and wrong about this,
# which only showed up once a real device build tried to load a bundle.
#
# The cost is real: hoisting gives up per-package dependency isolation, so a
# package can import something it never declared and nothing will stop it.
# Accepted, because the alternative is no mobile app.
node-linker=hoisted

# React is pinned to one exact version in package.json's pnpm.overrides.
#
# node-linker=hoisted means the whole workspace shares one copy of react and one
# of react-dom. apps/mobile pins react to 19.2.3 because Expo SDK 57 requires
# that exact version; apps/web asked for ^19.0.0 and resolved react-dom to
# 19.2.8. One hoisted copy of each, at different versions, and next build died
# with "Incompatible React versions" after compiling successfully, so the web
# app could not be deployed at all.
#
# The override is the constraint stated once rather than the same exact version
# repeated in two package.json files that can drift apart silently.
